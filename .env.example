# Colyseus / Express listens on this port. Hosting platforms usually inject PORT.
PORT=2567

# Optional: only needed when frontend and Colyseus server are hosted on different origins.
# Example: ALLOWED_ORIGINS=https://your-game.example
ALLOWED_ORIGINS=http://localhost:5173

# Optional Vite build-time override when frontend is deployed separately.
# Leave blank when the same Node service serves the frontend and game server.
VITE_SERVER_URL=
